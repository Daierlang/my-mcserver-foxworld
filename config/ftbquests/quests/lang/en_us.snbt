{
	chapter.00000000000000A1.chapter_subtitle: [
		"从一棵树到一片屋檐：第一天生存清单。"
	]
	chapter.00000000000000A1.title: "第一章 安家立业"
	chapter.00000000000000A2.chapter_subtitle: [
		"P 点、御币与祭坛：把女仆接回家。"
	]
	chapter.00000000000000A2.title: "第二章 召唤女仆"
	chapter.00000000000000A3.chapter_subtitle: [
		"踩汁、发酵与陈酿：从劣质到典藏。"
	]
	chapter.00000000000000A3.title: "第三章 酿酒大师"
	chapter.00000000000000A4.chapter_subtitle: [
		"硬币、钱包与店铺：让钱生钱。"
	]
	chapter.00000000000000A4.title: "第四章 酒馆经济学家"
	chapter.00000000000000A5.chapter_subtitle: [
		"圈地、组队与路石：守住家，走得更远。"
	]
	chapter.00000000000000A5.title: "第五章 圈地与传送"
	chapter.00000000000000A6.chapter_subtitle: [
		"制图师、探险地图与 Terralith：为美酒远行。"
	]
	chapter.00000000000000A6.title: "第六章 寻酒远征"
	quest.0000000000001101.quest_desc: [
		"徒手撸树是一切的起点。"
		"目标：收集 8 个任意原木（橡树、云杉均可）。"
	]
	quest.0000000000001101.title: "砍下第一棵树"
	quest.0000000000001102.quest_desc: [
		"合成工作台，再升级到石器工具。"
		"目标：持有一把石镐（ JEI：R 键查配方，U 键查用途）。"
	]
	quest.0000000000001102.title: "工作台与石器"
	quest.0000000000001103.quest_desc: [
		"找到一处 DnT 改造村庄或森罗酒馆，或自己搭建小屋。"
		"熔炉、火把、一张床，夜晚不再手忙脚乱。"
	]
	quest.0000000000001103.title: "安身之所"
	quest.0000000000001104.quest_desc: [
		"本服的狐狸可以被驯服（Tameable Foxes）。"
		"手持甜浆果长按右键尝试（具体机制待确认，多试几次）。"
		"驯服后的狐狸会跟随并协助主人。"
	]
	quest.0000000000001104.title: "驯服狐狸"
	quest.0000000000001105.quest_desc: [
		"河流与野外的野生葡萄藤可以采摘。"
		"目标：收集 3 个葡萄——这是第三章的入场券。"
	]
	quest.0000000000001105.title: "河边野生葡萄"
	quest.0000000000001201.quest_desc: [
		"夜晚野外会刷出妖精，击杀后拾取 P 点。"
		"目标：收集 5 个 P 点。"
		"提示：P 点也是 TLM 合成的核心材料。"
	]
	quest.0000000000001201.title: "妖精猎人"
	quest.0000000000001202.quest_desc: [
		"用 P 点等材料合成博丽御币。"
		"配方请在 JEI 搜索「博丽御币」确认（待确认，版本可能调整）。"
	]
	quest.0000000000001202.title: "博丽御币"
	quest.0000000000001203.quest_desc: [
		"祭坛是多方块结构，摆法请查 MC 百科「祭坛（TLM）」（待确认）。"
		"目标：放置一个祭坛方块开始搭建。"
	]
	quest.0000000000001203.title: "搭建祭坛"
	quest.0000000000001204.quest_desc: [
		"手持博丽御币对祭坛启动仪式，消耗 P 点与蛋糕等材料（待确认）。"
		"仪式成功后会出现女仆实体。"
	]
	quest.0000000000001204.title: "召唤仪式"
	quest.0000000000001205.quest_desc: [
		"手持蛋糕对女仆右键完成驯服。"
		"驯服后 Shift+右键可打开 GUI。"
	]
	quest.0000000000001205.title: "蛋糕驯服"
	quest.0000000000001206.quest_desc: [
		"在女仆 GUI 里指派工作：战斗、伐木、耕种、酿酒……"
		"配合「狐步酿香」，女仆还能帮你踩汁酿酒！"
		"没有好工作？女仆背包、神社庭院灯都可以安排上。"
	]
	quest.0000000000001206.title: "女仆上岗"
	quest.0000000000001301.quest_desc: [
		"破坏野生葡萄藤获得葡萄，右键种下藤架。"
		"目标：持有一个 Vinery 红葡萄。"
	]
	quest.0000000000001301.title: "种下葡萄藤"
	quest.0000000000001302.quest_desc: [
		"把葡萄倒进果汁盆（grapevine_pot），跳进去踩！"
		"女仆装备踩汁笼可以代劳（狐步酿香）。"
		"目标：获得一瓶红葡萄汁。"
	]
	quest.0000000000001302.title: "果汁盆踩汁"
	quest.0000000000001303.quest_desc: [
		"果汁放进发酵桶约 5 分钟即成酒。"
		"Vinery 一共有 26 种酒等你解锁。"
	]
	quest.0000000000001303.title: "发酵桶初酿"
	quest.0000000000001304.quest_desc: [
		"另一条酿酒线：森罗酒馆。"
		"葡萄棚架下的底块决定葡萄品种：泥土/草方块→葡萄，冰→冰葡萄，下界岩→黄金葡萄。"
	]
	quest.0000000000001304.title: "森罗葡萄"
	quest.0000000000001305.quest_desc: [
		"森罗果盆踩汁→桶装果汁倒入酒桶发酵。"
		"品质随时间提升：难以下咽→劣质→普通→优质→精酿→典藏（12 分钟以上）。"
		"装 Jade 模组可直接看木桶状态。"
	]
	quest.0000000000001305.title: "森罗木桶陈酿"
	quest.0000000000001306.quest_desc: [
		"用龙头+空瓶从木桶取酒。"
		"典藏葡萄酒=生命提升 IV、香槟=抗性 VI、伏特加/威士忌=急迫 VI、白兰地=力量 VI。"
		"酿过头会变成醋——记得掐表！"
	]
	quest.0000000000001306.title: "六大品质"
	quest.0000000000001307.quest_desc: [
		"目标：取出一瓶陈酿 12 分钟以上的典藏级葡萄酒。"
		"这是酒客的最高荣誉。"
	]
	quest.0000000000001307.title: "典藏之味"
	quest.0000000000001308.quest_desc: [
		"Brewin 酒桶可以酿啤酒、伏特加、清酒……"
		"更多酒线与图鉴见后续章节。"
		"狐步酿香让女仆替你踩汁。祝酒运昌隆！"
	]
	quest.0000000000001308.title: "酒鬼之路"
	quest.0000000000001401.quest_desc: [
		"找到 LC 商人（Trader）卖货，或完成前面章节奖励。"
		"目标：获得 1 枚铜币。"
		"按 V 键打开钱包 GUI。"
	]
	quest.0000000000001401.title: "第一枚硬币"
	quest.0000000000001402.quest_desc: [
		"皮革与硬币合成钱包（具体配方 JEI 查询，待确认）。"
		"Coin Chest 可以整箱存币。"
	]
	quest.0000000000001402.title: "合成钱包"
	quest.0000000000001403.quest_desc: [
		"右键商人打开交易界面，卖出货物赚取硬币。"
		"目标：赚到 1 枚铁币。"
	]
	quest.0000000000001403.title: "成交第一单"
	quest.0000000000001404.quest_desc: [
		"合成并放置「物品商人」，Shift+右键配置收购/出售。"
		"定价合理，其他玩家就会来光顾。"
	]
	quest.0000000000001404.title: "开店当老板"
	quest.0000000000001405.quest_desc: [
		"铸币机可以把低面额硬币熔铸成高面额。"
		"下界合金钱包自带 ATM 功能。"
	]
	quest.0000000000001405.title: "铸币机"
	quest.0000000000001501.quest_desc: [
		"按键盘上的 '（单引号）打开 OPAC 领地 GUI。"
		"这里可以查看、创建和管理你的领地。"
	]
	quest.0000000000001501.title: "打开领地界面"
	quest.0000000000001502.quest_desc: [
		"命令：/oclaims claim [x1 z1 x2 z2] 矩形圈地。"
		"/oclaims about 查看领地信息，/oclaims unclaim 取消。"
		"/oclaims forceload 让领地区块保持加载（挂机炼酒神器）。"
	]
	quest.0000000000001502.title: "圈下第一块地"
	quest.0000000000001503.quest_desc: [
		"/oparties create 创建队伍，/oparties invite 邀请好友。"
		"队伍成员可以共享领地编辑权与任务进度。"
	]
	quest.0000000000001503.title: "组建团队"
	quest.0000000000001504.quest_desc: [
		"野外会生成天然路石碑（Waystone），右键激活即可绑定。"
		"激活后可互相传送（消耗经验）。跨维度传送待确认。"
	]
	quest.0000000000001504.title: "激活路石碑"
	quest.0000000000001505.quest_desc: [
		"合成或用奖励获得路石碑，放在家门口并命名。"
		"从此告别长途跋涉。"
	]
	quest.0000000000001505.title: "建造自己的路石"
	quest.0000000000001506.quest_desc: [
		"Warp Scroll 随身传送、Return Scroll 回家、Warp Stone 充能后无限传送。"
		"目标：持有一个任意传送卷轴。"
	]
	quest.0000000000001506.title: "卷轴大师"
	quest.0000000000001601.quest_desc: [
		"DnT 酒馆二楼住着制图师。"
		"用绿宝石和他交换结构探险地图。"
		"目标：收集 8 颗绿宝石（交易或挖矿）。"
	]
	quest.0000000000001601.title: "拜访制图师"
	quest.0000000000001602.quest_desc: [
		"跟随探险地图的标记找到目标结构。"
		"搜刮战利品箱，别错过酒窖里的陈酿。"
	]
	quest.0000000000001602.title: "按图索骥"
	quest.0000000000001603.quest_desc: [
		"本服世界由 Terralith 重塑，充满奇特群系。"
		"目标：探索一个你从未见过的 Terralith 群系。"
	]
	quest.0000000000001603.title: "群系远行者"
	quest.0000000000001604.quest_desc: [
		"终极挑战：探索 3 个不同的酒馆/结构。"
		"集齐战利品，带回美酒与传说。"
		"完成者将获得丰厚补给！"
	]
	quest.0000000000001604.title: "酒馆大满贯"
	chapter.00000000000000A7.title: "料理与餐桌"
	chapter.00000000000000A7.chapter_subtitle: ["锅碗瓢盆与茶饭香：从简餐到满汉全席。"]
	chapter.00000000000000A8.title: "酒品图鉴"
	chapter.00000000000000A8.chapter_subtitle: ["集齐天下佳酿：从苹果酒到 82 年拉菲。"]
	chapter.00000000000000A9.title: "女仆养成"
	chapter.00000000000000A9.chapter_subtitle: ["喂食、工作与饰品：把女仆养成得力伙伴。"]
	chapter.00000000000000AA.title: "魔法冒险"
	chapter.00000000000000AA.chapter_subtitle: ["万法皆通：寻风铃、静修处与星之魔女。"]
	chapter.00000000000000AB.title: "管理员专用"
	chapter.00000000000000AB.chapter_subtitle: ["服主运维工具：预生成、边界、性能与备份。"]
	quest.0000000000001109.title: "JEI 查配方"
	quest.0000000000001109.quest_desc: [
		"JEI 是查配方的好帮手。"
		"对着物品按 R 查配方、U 查用途，不用再翻 Wiki。"
	]
	quest.000000000000110A.title: "Jade 看方块"
	quest.000000000000110A.quest_desc: [
		"准星指着方块，屏幕上就会显示它的名字与信息。"
		"装了模组的方块也会显示额外提示（Jade）。"
	]
	quest.000000000000110B.title: "AppleSkin 饱食度"
	quest.000000000000110B.quest_desc: [
		"饱食度图标下方会显示隐藏的饱和度（AppleSkin）。"
		"吃饭前看一眼，别浪费胃容量。"
	]
	quest.000000000000110C.title: "狐狸亲昵"
	quest.000000000000110C.quest_desc: [
		"驯服后的狐狸可以用甜浆果喂食互动（Tameable Foxes）。"
		"多喂几次，狐狸会越来越黏人。"
	]
	quest.000000000000110D.title: "狐狸的礼物"
	quest.000000000000110D.quest_desc: [
		"狐狸有时会叼着礼物回到主人身边。"
		"带上你的狐狸散散步，看看它能叼回什么好东西。"
	]
	quest.000000000000110E.title: "铁器时代"
	quest.000000000000110E.quest_desc: [
		"挖到铁，合成一把铁镐，才算真正走出新手村。"
		"后面的章节大多默认你已经有铁器了。"
	]
	quest.000000000000110F.title: "下界之旅"
	quest.000000000000110F.quest_desc: [
		"搭一座下界传送门，去下界看看。"
		"门框 4×5 用 10 个黑曜石就够，带好金装与食物。"
	]
	quest.0000000000001110.title: "酿造台"
	quest.0000000000001110.quest_desc: [
		"合成酿造台，为药水与酿酒玩法做准备。"
		"烈焰棒来自下界要塞。"
	]
	quest.0000000000001209.title: "妖精猎人"
	quest.0000000000001209.quest_desc: [
		"夜晚野外刷出的妖精会掉 P 点。"
		"再打 3 只，凑够备用 P 点。"
	]
	quest.000000000000120A.title: "女仆的背包"
	quest.000000000000120A.quest_desc: [
		"给女仆配一个背包（小/中/大三种）。"
		"女仆会自动用它帮你收集掉落物。"
	]
	quest.000000000000120B.title: "女仆的小床"
	quest.000000000000120B.quest_desc: [
		"合成一张女仆床，女仆可以睡觉回血。"
		"放在基地里，让女仆也有个家。"
	]
	quest.000000000000120C.title: "防爆护符"
	quest.000000000000120C.quest_desc: [
		"给女仆装备防爆护符，苦力怕再也炸不了家。"
		"护符要装进女仆装备栏才生效。"
	]
	quest.000000000000120D.title: "聪明牌"
	quest.000000000000120D.quest_desc: [
		"合成聪明牌（Soul Spell），解锁女仆更聪明的行为。"
		"按说明书放置与使用。"
	]
	quest.000000000000120E.title: "女仆的扫帚"
	quest.000000000000120E.quest_desc: [
		"合成扫帚，女仆可以骑着飞。"
		"也是不错的装饰摆件。"
	]
	quest.0000000000001309.title: "女仆踩汁"
	quest.0000000000001309.quest_desc: [
		"狐步酿香：带女仆到果汁盆边，让她帮你踩汁。"
		"女仆踩汁效率更高，还有专属动画。"
	]
	quest.000000000000130A.title: "森罗香槟"
	quest.000000000000130A.quest_desc: [
		"在森罗木桶里陈酿出香槟。"
		"开香槟庆祝一下！"
	]
	quest.000000000000130B.title: "蒸馏烈性"
	quest.000000000000130B.quest_desc: [
		"酿出伏特加。"
		"烈酒与鸡尾酒的世界在向你招手。"
	]
	quest.000000000000130C.title: "神秘鸡尾酒"
	quest.000000000000130C.quest_desc: [
		"用摇酒壶调出一杯神秘鸡尾酒。"
		"配方随机，效果也随机——这就是惊喜。"
	]
	quest.000000000000130D.title: "调酒装备"
	quest.000000000000130D.quest_desc: [
		"合成摇酒壶与空杯具，正式开业调酒。"
		"鸡尾酒图鉴在第五章等你。"
	]
	quest.000000000000130E.title: "典藏之后"
	quest.000000000000130E.quest_desc: [
		"你酿出了第一瓶典藏——酒庄的传说才刚刚开始。"
		"第五章的酒品图鉴已经向你敞开。"
	]
	quest.0000000000001409.title: "金币进阶"
	quest.0000000000001409.quest_desc: [
		"把铁币送进铸币机，压出更有分量的金币。"
		"一枚金币顶九枚铁币，大额交易再也不用背一袋零钱。"
	]
	quest.000000000000140A.title: "绿币时代"
	quest.000000000000140A.quest_desc: [
		"绿宝石币是市面流通的最高面额之一。"
		"攒酒钱的好方式：高价酒卖出后直接铸成绿币。"
	]
	quest.000000000000140B.title: "移动终端"
	quest.000000000000140B.quest_desc: [
		"合成便携交易终端，随身访问商店网络。"
		"走到哪卖到哪，酒馆经济学家的终极形态。"
	]
	quest.0000000000001509.title: "传送中枢"
	quest.0000000000001509.quest_desc: [
		"合成传送石（Warp Stone），随时传回绑定的路石。"
		"不需要卷轴，冷却好了就能走。"
	]
	quest.000000000000150A.title: "双向传送门"
	quest.000000000000150A.quest_desc: [
		"建造一对传送门板块（Warp Plate），实现两点即时往返。"
		"酒馆到葡萄园的通勤线，一步到位。"
	]
	quest.0000000000001609.title: "酒馆寻踪"
	quest.0000000000001609.quest_desc: [
		"在制图师处换一张酒馆探索地图，找到任意一座酒馆并踏入其中。"
		"酒馆有 11 种木材变体，沙漠与雪原上也找得到。"
	]
	quest.000000000000160A.title: "瞭望塔顶"
	quest.000000000000160A.quest_desc: [
		"登上森林深处的消防瞭望塔。"
		"塔顶视野极佳，适合顺路插一个路石。"
	]
	quest.000000000000160B.title: "水下遗迹"
	quest.000000000000160B.quest_desc: [
		"潜入海底，探索导管遗迹。"
		"带上水肺药水与夜视，遗迹里藏着海洋之心。"
	]
	quest.000000000000160C.title: "流浪堡垒"
	quest.000000000000160C.quest_desc: [
		"找到流浪者的堡垒并踏入其中。"
		"小心流髑的箭，堡垒的箱子值得一搜。"
	]
	quest.000000000000160D.title: "灾厄庄园"
	quest.000000000000160D.quest_desc: [
		"灾厄村民的豪华庄园——里里外外都是掠夺者。"
		"备好装备再进，战利品也最丰厚。"
	]
	quest.000000000000160E.title: "女巫别墅"
	quest.000000000000160E.quest_desc: [
		"沼泽边的女巫别墅，炼药材料应有尽有。"
		"小心女巫的喷溅药水。"
	]
	quest.000000000000160F.title: "亡灵地穴"
	quest.000000000000160F.quest_desc: [
		"深入地下的亡灵地穴，亡灵扎堆。"
		"带上光源与武器，注意脚下。"
	]
	quest.0000000000001610.title: "浮空岛"
	quest.0000000000001610.quest_desc: [
		"Terralith 的浮空岛群系：脚下的方块悬浮在云端。"
		"搭桥过去，小心别掉下去。"
	]
	quest.0000000000001611.title: "火山之地"
	quest.0000000000001611.quest_desc: [
		"火山口群系：在岩浆与黑石之间小心行走。"
		"防火药水是好朋友。"
	]
	quest.0000000000001612.title: "紫晶峡谷"
	quest.0000000000001612.quest_desc: [
		"紫晶峡谷：峡谷壁上长满紫水晶。"
		"顺手敲几块回家做望远镜。"
	]
	quest.0000000000001613.title: "薰衣草谷"
	quest.0000000000001613.quest_desc: [
		"薰衣草谷：紫色的花海与成群的蜜蜂。"
		"拍照打卡的绝佳背景。"
	]
	quest.0000000000001614.title: "村庄风情画"
	quest.0000000000001614.quest_desc: [
		"探访四种变体村庄：白桦、丛林、沼泽与针叶林。"
		"每个村庄的建筑风格完全不同，值得绕路一看。"
	]
	quest.0000000000001615.title: "探索大成"
	quest.0000000000001615.quest_desc: [
		"七类结构、四种群系、四座村庄——整片大陆都留下过你的脚印。"
		"这份隐藏大奖，献给真正的探索家。"
	]
	quest.0000000000001701.title: "厨刀与菜板"
	quest.0000000000001701.quest_desc: [
		"Farmer's Delight 的烹饪从一把燧石刀和一块菜板开始。"
		"刀可以切菜、增加掉落；菜板用来加工食材。"
	]
	quest.0000000000001702.title: "灶台与锅"
	quest.0000000000001702.quest_desc: [
		"合成灶台与烹饪锅。"
		"锅可以直接放在灶台上炖菜。"
	]
	quest.0000000000001703.title: "田园三宝"
	quest.0000000000001703.quest_desc: [
		"种出番茄、卷心菜和水稻。"
		"它们是 Farmer's Delight 菜谱的三大基础食材。"
	]
	quest.0000000000001704.title: "炖锅常备菜"
	quest.0000000000001704.quest_desc: [
		"在烹饪锅里炖一锅牛肉炖菜。"
		"炖菜比烤肉更管饱。"
	]
	quest.0000000000001705.title: "米饭与炒饭"
	quest.0000000000001705.quest_desc: [
		"煮一锅米饭，再炒一盘炒饭。"
		"稻米要先在水边找水稻丛，割稻穗取得。"
	]
	quest.0000000000001706.title: "中式灶台"
	quest.0000000000001706.quest_desc: [
		"森罗厨房的中式灶台，配合炒锅、汤锅做中餐。"
		"这条料理线比西式更丰盛。"
	]
	quest.0000000000001707.title: "面粉与面团"
	quest.0000000000001707.quest_desc: [
		"磨出面粉，和成面团。"
		"面食世界的大门从这里打开。"
	]
	quest.0000000000001708.title: "包子的香气"
	quest.0000000000001708.quest_desc: [
		"蒸一笼包子。"
		"用森罗厨房的蒸锅与面团制作。"
	]
	quest.0000000000001709.title: "种茶制茶"
	quest.0000000000001709.quest_desc: [
		"种下茶籽，收获鲜叶并烘干成干茶叶。"
		"茶叶是所有茶饮的基础。"
	]
	quest.000000000000170A.title: "泡一壶好茶"
	quest.000000000000170A.quest_desc: [
		"用茶壶泡一壶铁观音。"
		"不同茶叶泡出不同的茶，效果各异。"
	]
	quest.000000000000170B.title: "番茄炒蛋盖饭"
	quest.000000000000170B.quest_desc: [
		"经典国民菜：番茄炒蛋盖饭。"
		"森罗厨房炒锅出品。"
	]
	quest.000000000000170C.title: "红烧牛肉"
	quest.000000000000170C.quest_desc: [
		"炖一锅红烧牛肉。"
		"硬菜顶饱，属性也不错。"
	]
	quest.000000000000170D.title: "佛跳墙"
	quest.000000000000170D.quest_desc: [
		"森罗厨房的顶级大菜：佛跳墙。"
		"集齐高级食材，慢炖而成。"
	]
	quest.000000000000170E.title: "腌制泡菜"
	quest.000000000000170E.quest_desc: [
		"Brewin and Chewin 的发酵玩法：腌一坛泡菜。"
		"把蔬菜放进发酵桶里腌制。"
	]
	quest.000000000000170F.title: "满汉全席"
	quest.000000000000170F.quest_desc: [
		"包子、红烧牛肉、佛跳墙、泡菜都做过了——开席！"
		"你的餐桌已经初具规模。"
	]
	quest.0000000000001800.title: "图鉴开篇"
	quest.0000000000001800.quest_desc: [
		"酿出第一桶发酵酒后，开始收集酒品图鉴。"
		"本章全部为展示型收集（不消耗酒），图鉴完成有隐藏大奖。"
	]
	quest.0000000000001801.title: "经典六酿"
	quest.0000000000001801.quest_desc: [
		"苹果酒、苹果汁酒、红酒、樱桃酒、蜂蜜酒、冰酒。"
		"Vinery 最经典的六款，全部在发酵桶酿成。"
	]
	quest.0000000000001802.title: "传说六酿"
	quest.0000000000001802.quest_desc: [
		"紫颂酒、海带酒、神盾酒、博尔瓦酒、Moja 黑标、村民惊魂。"
		"每一款都有传说背景。"
	]
	quest.0000000000001803.title: "传记八酿"
	quest.0000000000001803.quest_desc: [
		"Chenet、Clark、Creepers Crush、Cristel、Glowing Wine、Jellie、Jo 特调、Lilitu。"
		"以人物与故事命名的八款酒。"
	]
	quest.0000000000001804.title: "名仕六酿"
	quest.0000000000001804.quest_desc: [
		"磁力酒与唱片系列：Mellohi、Noir、Solaris、Stal、Strad。"
		"喝起来有音乐的味道。"
	]
	quest.0000000000001805.title: "森罗烈酒"
	quest.0000000000001805.quest_desc: [
		"森罗酒馆的葡萄酒、威士忌、白兰地、朗姆与香槟。"
		"木桶陈酿时间的艺术。"
	]
	quest.0000000000001806.title: "麦酒与清酒"
	quest.0000000000001806.quest_desc: [
		"Brewin and Chewin：啤酒、伏特加、清酒。"
		"发酵桶里的另一条酒线。"
	]
	quest.0000000000001807.title: "鸡尾酒四式"
	quest.0000000000001807.quest_desc: [
		"白色淑女、蚱蜢、螺丝起子、莫吉托。"
		"摇酒壶 + 冰 + 果汁，调出经典四式。"
	]
	quest.0000000000001808.title: "世界名酒"
	quest.0000000000001808.quest_desc: [
		"茅台、82 年拉菲、长岛冰茶。"
		"世界名酒 mod 的三款招牌。"
	]
	quest.0000000000001809.title: "夜宵甜点"
	quest.0000000000001809.quest_desc: [
		"波奇布丁、魔法脆角、喜多卷饼、凉山冰糕。"
		"喝酒怎么少得了下酒甜点。"
	]
	quest.000000000000180A.title: "冰茶与挚友"
	quest.000000000000180A.quest_desc: [
		"世界名酒附赠的两款无酒精饮品：冰茶与挚友特饮。"
		"不喝酒的客人也有得选。"
	]
	quest.000000000000180B.title: "图鉴大成"
	quest.000000000000180B.quest_desc: [
		"整张酒单都被你喝遍了——传奇酒客实至名归。"
		"这份隐藏大奖，只有图鉴收藏家能看到。"
	]
	quest.0000000000001901.title: "养成开篇"
	quest.0000000000001901.quest_desc: [
		"女仆上岗只是开始，养成才是正片。"
		"本章目标：饮食、工作、装备三线并进。"
	]
	quest.0000000000001902.title: "饮食多样化"
	quest.0000000000001902.quest_desc: [
		"萝贝给女仆的饮食多样化系统：喂她吃没吃过的食物。"
		"吃得越杂，属性加成越高——血量、护甲、攻击、好感都会涨。"
	]
	quest.0000000000001903.title: "果园小帮手"
	quest.0000000000001903.quest_desc: [
		"带女仆去葡萄园，让她采收葡萄（主手配剪刀掉落更多）。"
		"采得越高，好感越多（女仆酒馆机制）。"
	]
	quest.0000000000001904.title: "农田全能"
	quest.0000000000001904.quest_desc: [
		"女仆可以耕地、播种、收割、剪羊毛、捡拾掉落物。"
		"把农活交给她们，自己酿酒去。"
	]
	quest.0000000000001905.title: "背包升级"
	quest.0000000000001905.quest_desc: [
		"中背包收纳更多，工作台背包随走随合成。"
		"装备栏里装上背包才生效。"
	]
	quest.0000000000001906.title: "护符双联"
	quest.0000000000001906.quest_desc: [
		"防火护符 + 抵射护符，女仆生存能力翻倍。"
		"护符装进女仆装备栏才生效。"
	]
	quest.0000000000001907.title: "万法发簪"
	quest.0000000000001907.quest_desc: [
		"万法皆通的发簪：女仆装备后可施法。"
		"万法皆通体系的女仆装备从这里开始。"
	]
	quest.0000000000001908.title: "巧匠与储物"
	quest.0000000000001908.quest_desc: [
		"芬芳匠心提升女仆手工能力，末影口袋提供随身储物。"
		"都是女仆可装备的万法皆通道具。"
	]
	quest.0000000000001909.title: "速咏与回春"
	quest.0000000000001909.quest_desc: [
		"迅捷咏唱环加速施法，回春环给女仆持续治疗。"
		"万法皆通戒指系列。"
	]
	quest.000000000000190A.title: "寻风铃"
	quest.000000000000190A.quest_desc: [
		"寻风铃指向隐秘静修处（The Retreat）。"
		"这是第七章魔法冒险的入场券。"
	]
	quest.000000000000190B.title: "静修之地"
	quest.000000000000190B.quest_desc: [
		"手持寻风铃潜入 The Retreat。"
		"Shift+右键铃铛可快速返回。"
	]
	quest.000000000000190C.title: "镇压之石"
	quest.000000000000190C.quest_desc: [
		"放置镇压石，3 区块内不再刷怪。"
		"基地安防神器。"
	]
	quest.000000000000190D.title: "养成大成"
	quest.000000000000190D.quest_desc: [
		"饮食、工作、装备三线全部就位。"
		"你的女仆已经是独当一面的伙伴了。"
	]
	quest.0000000000001A00.title: "魔法之路"
	quest.0000000000001A00.quest_desc: [
		"女仆养成已入门，万法皆通的冒险线正式开启。"
		"本章围绕寻风铃、星辉匕首与星之魔女展开。"
	]
	quest.0000000000001A01.title: "灵晶与流核"
	quest.0000000000001A01.quest_desc: [
		"收集岩晶与流核——万法皆通的基础材料。"
		"它们出现在魔法结构与战利品袋中。"
	]
	quest.0000000000001A02.title: "魔导书"
	quest.0000000000001A02.quest_desc: [
		"收集魂之书与混沌之书。"
		"解锁更多女仆魔法行为。"
	]
	quest.0000000000001A03.title: "刃与锚核"
	quest.0000000000001A03.quest_desc: [
		"裂魂霜刃与锚核——战斗向的核心装备。"
		"出现在魔法结构的宝箱里。"
	]
	quest.0000000000001A04.title: "星辉匕首"
	quest.0000000000001A04.quest_desc: [
		"合成星辉匕首。"
		"Shift+右键配置后，用它向星之魔女邀战。"
	]
	quest.0000000000001A05.title: "挑战星之魔女"
	quest.0000000000001A05.quest_desc: [
		"手持星辉匕首向星之魔女发起挑战并击败她。"
		"这是万法皆通的毕业 BOSS 战，做好万全准备。"
	]
	quest.0000000000001A06.title: "星核"
	quest.0000000000001A06.quest_desc: [
		"击败星之魔女后掉落星核。"
		"它是毕业饰品的合成材料。"
	]
	quest.0000000000001A07.title: "梦云水晶"
	quest.0000000000001A07.quest_desc: [
		"用星核合成梦云水晶——女仆的毕业饰品。"
		"给你的女仆戴上吧。"
	]
	quest.0000000000001A08.title: "影之刺客"
	quest.0000000000001A08.quest_desc: [
		"在魔法结构中讨伐 3 只影之刺客。"
		"小心它们的瞬移背刺。"
	]
	quest.0000000000001A09.title: "堕落骑士"
	quest.0000000000001A09.quest_desc: [
		"讨伐 3 只堕落骑士。"
		"它们守护着重要的战利品。"
	]
	quest.0000000000001A0A.title: "星陨之铁"
	quest.0000000000001A0A.quest_desc: [
		"收集星陨铁——坠落的星辰碎片。"
		"它是铸造星辉武器的重要材料。"
	]
	quest.0000000000001A0B.title: "魔法大成"
	quest.0000000000001A0B.quest_desc: [
		"梦云水晶入手、强敌讨伐完毕、星陨铁在手。"
		"你已经站在万法皆通的顶点。"
	]
	quest.0000000000001B00.title: "世界预生成"
	quest.0000000000001B00.quest_desc: [
		"管理员：/chunky radius 3000 设定预生成半径，然后 /chunky start。"
		"生成期间留意 TPS，完成后 /chunky pause 或等待自动结束。"
	]
	quest.0000000000001B01.title: "世界边界"
	quest.0000000000001B01.quest_desc: [
		"管理员：/chunky border add 按预生成范围加上边界。"
		"防止玩家跑出已生成区域造成卡顿。"
	]
	quest.0000000000001B02.title: "性能体检"
	quest.0000000000001B02.quest_desc: [
		"管理员：/spark tps 查看 TPS 与 MSPT。"
		"卡顿时 /spark profiler --timeout 60 抓一份分析报告。"
	]
	quest.0000000000001B03.title: "备份检查"
	quest.0000000000001B03.quest_desc: [
		"管理员：确认 AdvancedBackups 的定期备份正在正常运行。"
		"检查 backups 目录里最近的备份文件时间戳。"
	]
	quest.0000000000001111.title: "欢迎来到酒狐酒馆"
	quest.0000000000001111.quest_desc: [
		"这本任务书与《交易指南》会一直在你身边。"
		"任务书：浏览并完成任务，领取奖励。"
		"交易指南：学习 LC 货币、店铺与收购台的用法。"
		"开一家酒馆，做一位有故事的老板吧！"
	]
	chapter.00000000000000AC.title: "第十二章 酒客本色"
	chapter.00000000000000AC.chapter_subtitle: ["品鉴、备战与客商：把酒馆生意做进任务书。"]
	quest.0000000000001C01.title: "酒客上门"
	quest.0000000000001C01.quest_desc: [
		"欢迎来到「酒客本色」。"
		"在这里，你不是酿酒师，而是最挑剔的那位客人。"
		"勾选开启你的品酒之旅。"
	]
	quest.0000000000001C02.title: "初尝四酿"
	quest.0000000000001C02.quest_desc: [
		"集齐 4 款森罗酒馆的基础佳酿（持有即可，无需喝下）："
		"葡萄酒、香槟、樱花葡萄酒、蜂蜜葡萄酒。"
		"森罗酒馆的酒按酿造品级分六档，酒桶里陈酿越久品质越高。"
	]
	quest.0000000000001C03.title: "进阶酒单"
	quest.0000000000001C03.quest_desc: [
		"集齐 4 款进阶名酿："
		"冰葡萄酒、梅酒、红皇后、矿工之星。"
		"红皇后与矿工之星需要稀有原料与运气。"
	]
	quest.0000000000001C04.title: "镇店六酿"
	quest.0000000000001C04.quest_desc: [
		"集齐 6 款镇店之宝："
		"落日余晖、奢香夫人、雪婆婆、夜光新娘、萤花酿、佳丽私酿。"
		"集齐它们，你的酒柜就是全服最亮的风景。"
	]
	quest.0000000000001C05.title: "下酒菜不能少"
	quest.0000000000001C05.quest_desc: [
		"好酒配好菜：弄来一份红烧牛肉和一份蛋炒饭。"
		"森罗厨房的菜谱在 JEI 里都能查到。"
	]
	quest.0000000000001C06.title: "备战酒单"
	quest.0000000000001C06.quest_desc: [
		"BOSS 战前检查背包：至少带 2 款品质酒，吃饱喝足再开团。"
		"酒提供增益，食物提供续航。"
		"完成镇店六酿与下酒菜后勾选。"
	]
	quest.0000000000001C07.title: "从我买酒 I"
	quest.0000000000001C07.quest_desc: [
		"去别的玩家的摊位/店铺买一次酒（或卖一次酒给客商）。"
		"让同行互为客商，钱要在酒馆之间流动起来。"
		"完成后自行勾选（管理员抽查交易记录）。"
	]
	quest.0000000000001C08.title: "从我买酒 II"
	quest.0000000000001C08.quest_desc: [
		"第二笔交易：与不同的玩家再成交一次酒水生意。"
		"老客户带新客户，生意越做越大。"
	]
	quest.0000000000001C09.title: "从我买酒 III"
	quest.0000000000001C09.quest_desc: [
		"第三笔交易：固定客源已初步形成。"
		"提示：合伙共营酒馆、互相供货，是最高效的客源。"
	]
	quest.0000000000001C0A.title: "夜半酒香"
	quest.0000000000001C0A.quest_desc: [
		"深夜回到酒馆，亲眼见证女仆偷酒的现场。"
		"夜里的酒馆并不安静——守住你的酒柜，或者笑着装没看见。"
		"完成后自行勾选。"
	]
	quest.0000000000001C0B.title: "品鉴家"
	quest.0000000000001C0B.quest_desc: [
		"隐藏成就：镇店六酿与备战酒单全部达成。"
		"你是本店认证的品鉴家。"
	]
	chapter.00000000000000AD.title: "酒馆活动日历"
	chapter.00000000000000AD.chapter_subtitle: ["每周活动预告：管理员发布，奖品以 LC 结算。"]
	quest.0000000000001D01.title: "品酒大会（每周活动）"
	quest.0000000000001D01.quest_desc: [
		"说明页，不占用任务进度，管理员每周在此发布活动。"
		"品酒大会：管理员摆出盲品酒局，猜中酿造品级与酒名得分。"
		"奖品以 LC 结算，从活动奖励池随机发放。"
	]
	quest.0000000000001D02.title: "酿酒大赛（每周活动）"
	quest.0000000000001D02.quest_desc: [
		"酿酒大赛：每周指定一款酒，比拼酿造品级与数量。"
		"评委由管理员与玩家代表担任，前三名获得 LC 奖励。"
	]
	quest.0000000000001D03.title: "限定酒单周（每周活动）"
	quest.0000000000001D03.quest_desc: [
		"限定酒单周：管理员每周推出一款本店限定酒与限定价格。"
		"只在指定摊位有售，售完即止。"
	]
	quest.0000000000001D04.title: "客源在哪里"
	quest.0000000000001D04.quest_desc: [
		"持续客源两条路："
		"一、与朋友合伙共营酒馆，互相导流。"
		"二、推进魔法冒险线（第十一章），稀有材料换稀有客。"
	]
	quest.0000000000001C0C.title: "初识酒狐佳酿"
	quest.0000000000001C0C.quest_desc: [
		"女仆们的家乡酒——酒狐佳酿系列，共七款。"
		"先收藏前两款：篱下春、灯下影。"
		"每款酒都对应女仆的一份心意，收集越多，好感越深。"
	]
	quest.0000000000001C0D.title: "好感渐深"
	quest.0000000000001C0D.quest_desc: [
		"继续收藏三款进阶佳酿：暮朝酿、共影醇、经年霜。" 
		"经年霜尤为珍贵，需耐心陈酿。"
	]
	quest.0000000000001C0E.title: "挚友之礼"
	quest.0000000000001C0E.quest_desc: [
		"集齐最后三件：长相思、勿忘我，以及女仆亲手递上的「酒单」。" 
		"集齐全部七款佳酿与酒单，你就是酒狐姐妹认证的挚友。"
	]
	chapter.00000000000000AE.title: "第十四章 讨伐·入门"
	chapter.00000000000000AE.chapter_subtitle: [
		"冰原尽头，巫妖塔在等待挑战者。"
	]
	quest.0000000000001E01.title: "讨伐之路，从这里开始"
	quest.0000000000001E01.quest_desc: [
		"讨伐章是整本任务书最危险的一章，请做好万全准备。"
		"BOSS 战前检查：满级附魔装备、充足的食物与药水、备用装备。"
		"确认后勾选，正式踏上讨伐之路。"
	]
	quest.0000000000001E02.title: "寻找夜巫妖之塔"
	quest.0000000000001E02.quest_desc: [
		"夜巫妖之塔（Bosses of Mass Destruction）生成在寒冷群系。"
		"雪原、雪坡、冰刺之地、冻峰都有机会看到高耸的巫妖塔。"
		"抵达巫妖塔附近即完成本步。"
	]
	quest.0000000000001E03.title: "收集灵魂之星"
	quest.0000000000001E03.quest_desc: [
		"巫妖塔内部的祭坛需要灵魂之星才能唤醒巫妖。"
		"在塔内探索收集 4 颗灵魂之星（探索塔层与宝箱）。"
		"完成后交付（不消耗）。"
	]
	quest.0000000000001E04.title: "讨伐夜巫妖"
	quest.0000000000001E04.quest_desc: [
		"在塔顶祭坛放置灵魂之星，唤醒夜巫妖。"
		"巫妖会召唤幻影与盾牌，注意走位与打断。"
		"击杀夜巫妖，为酒馆讨回传说级的荣耀。"
	]
	quest.0000000000001E05.title: "上交古代灵魂"
	quest.0000000000001E05.quest_desc: [
		"夜巫妖掉落的古代灵魂是炼金与魔法的稀有材料。"
		"上交 2 个古代灵魂（不消耗），领取讨伐奖励。"
	]
	quest.0000000000001E06.title: "支线：巨像竞技场"
	quest.0000000000001E06.quest_desc: [
		"黑曜石巨像（Obsidilith）的竞技场遗迹散落在主世界。"
		"找到并抵达一座巨像竞技场。"
	]
	quest.0000000000001E07.title: "支线：讨伐黑曜石巨像"
	quest.0000000000001E07.quest_desc: [
		"登上竞技场祭坛唤醒黑曜石巨像。"
		"它会召唤护盾与符文攻击，远程与走位是关键。"
		"击杀黑曜石巨像。"
	]
	quest.0000000000001E08.title: "支线：讨伐虚空之花"
	quest.0000000000001E08.quest_desc: [
		"末地的虚空之花（Void Blossom）是隐藏 BOSS。"
		"准备好末地装备后再去挑战。"
		"击杀虚空之花。"
	]
	chapter.00000000000000AF.title: "第十五章 魔法学徒"
	chapter.00000000000000AF.chapter_subtitle: [
		"合成你的第一本法术书，踏上奥术之路。"
	]
	quest.0000000000001F01.title: "魔法之路，从这里开始"
	quest.0000000000001F01.quest_desc: [
		"魔法学徒章带你入门 Iron's Spellbooks 魔法系统。"
		"合成一本薄弱日志（初阶法术书）开启魔法生涯。"
		"确认开始后勾选。"
	]
	quest.0000000000001F02.title: "合成初阶法术书"
	quest.0000000000001F02.quest_desc: [
		"薄弱日志（Copper Spell Book）是每一位法师的起点。"
		"配方：铜锭、线与纸（JEI 查看详细配方）。"
		"合成并上交一本薄弱日志（不消耗）。"
	]
	quest.0000000000001F03.title: "装备法术书"
	quest.0000000000001F03.quest_desc: [
		"法术书装备在饰品栏（Curios）的法术书专属槽位。"
		"打开饰品栏，将法术书放入 Spell Book 槽位。"
		"装备后即可阅读与施放法术。"
	]
	quest.0000000000001F04.title: "施放第一个法术"
	quest.0000000000001F04.quest_desc: [
		"按法术书界面提示绑定法术到施法快捷键。"
		"施放你的第一个法术——对任何目标都可以。"
		"完成后勾选。"
	]
	quest.0000000000001F05.title: "合成学徒法术书"
	quest.0000000000001F05.quest_desc: [
		"进阶之路：合成学徒法术书（Gold Spell Book），法力上限更高。"
		"合成并上交一本学徒法术书（不消耗）。"
	]
	quest.0000000000001F06.title: "万法皆通的起点"
	quest.0000000000001F06.quest_desc: [
		"合成一张卷起的地图，它会指向下界深处的失落圣堂。"
		"失落圣堂（Lost Citadel）是魔法进阶的核心结构，与第十章万法皆通联动。"
		"上交地图（不消耗），魔法学徒之路正式毕业。"
	]
	chapter.00000000000000B0.title: "第十六章 天空之路"
	chapter.00000000000000B0.chapter_subtitle: [
		"造一艘飞艇，从天空俯瞰整片大陆。"
	]
	quest.0000000000002001.title: "合成船体"
	quest.0000000000002001.quest_desc: [
		"天空之路的第一步：Immersive Aircraft 飞行器部件。"
		"合成一个船体（原木 + 铁锭）。"
		"上交船体（不消耗）。"
	]
	quest.0000000000002002.title: "合成船帆与螺旋桨"
	quest.0000000000002002.quest_desc: [
		"船帆：白色地毯加线；螺旋桨：铁锭打造。"
		"两者都是飞行器的核心部件。"
		"上交船帆与螺旋桨（不消耗）。"
	]
	quest.0000000000002003.title: "合成锅炉与引擎"
	quest.0000000000002003.quest_desc: [
		"锅炉：铜锭环绕熔炉；引擎：锅炉 + 活塞 + 砂岩。"
		"引擎是飞行器的动力核心。"
		"上交锅炉与引擎（不消耗）。"
	]
	quest.0000000000002004.title: "合成飞艇或双翼机"
	quest.0000000000002004.quest_desc: [
		"飞艇：船帆围绕船体与引擎；双翼机：船体 + 引擎 + 螺旋桨。"
		"选择你的座驾，合成一艘飞艇或一架双翼机。"
		"上交飞行器物品（不消耗）。"
	]
	quest.0000000000002005.title: "加注燃料"
	quest.0000000000002005.quest_desc: [
		"手持煤炭（或任意固体燃料）对飞行器右键即可加注燃料。"
		"右键登上飞行器，体验第一次起飞。"
		"完成后勾选。"
	]
	quest.0000000000002006.title: "飞上空岛"
	quest.0000000000002006.quest_desc: [
		"驾驶飞行器前往 Terralith 空岛群系（天空群系）。"
		"从天空俯瞰整片大陆，感受风与自由。"
		"抵达空岛群系即完成本任务书全部主线。"
	]
	quest.0000000000001605.title: "死亡不掉落：留尸机制"
	quest.0000000000001605.quest_desc: [
		"本服安装了 Corpse 模组：死亡后尸体留在原地，物品不会散失。"
		"回到死亡地点，对尸体右键即可取回全部物品。"
		"再也不用担心跑图死亡丢装备了。"
	]
	quest.0000000000001112.title: "狐狸家族"
	quest.0000000000001112.quest_desc: [
		"本服狐狸无法直接驯服：用甜浆果喂两只成年狐狸，它们会繁衍幼崽。"
		"幼崽出生后就会信任并跟随你——这就是酒狐Server的驯狐之道。"
		"备好甜浆果，勾选完成。"
	]
	quest.0000000000001113.title: "开麦吧"
	quest.0000000000001113.quest_desc: [
		"服务器已启用 Simple Voice Chat：48 格内玩家实时语音，潜行可以私语，还能建群组。"
		"相关按键可在「按键绑定」菜单的 Simple Voice Chat 分组里查看和修改。"
		"向附近的酒友说句话，勾选完成。"
	]
	quest.0000000000001210.title: "零食柜与野餐"
	quest.0000000000001210.quest_desc: [
		"为女仆准备好零食柜，她饿了会自己去取零食。"
		"再带上野餐篮，邀请女仆来一场户外下午茶（可增加好感）。"
		"上交零食柜与野餐篮（不消耗）。"
	]
	quest.0000000000001211.title: "桌游时光"
	quest.0000000000001211.quest_desc: [
		"和女仆来一局五子棋或中国象棋——赢了可是有好感的。"
		"上交两种棋具（不消耗）。"
	]
	quest.0000000000001212.title: "女仆的镜头"
	quest.0000000000001212.quest_desc: [
		"用照相机记录女仆的日常，胶卷是耗材，多备几卷。"
		"照片会留存美好瞬间，别让相机吃灰。"
		"上交照相机与胶卷（不消耗）。"
	]
	quest.000000000000130F.title: "奶酪熟成坊"
	quest.000000000000130F.quest_desc: [
		"Brewin' and Chewin' 的奶酪轮放在地上会随时间慢慢熟成。"
		"亚麻奶酪轮与绯红奶酪轮熟成后切块，风味更佳。"
		"小贴士：微醺时聊天会乱码，狂醉能提升近战攻速——饮酒适量。"
		"上交两种奶酪轮（不消耗）。"
	]
	quest.000000000000140C.title: "银行服务"
	quest.000000000000140C.quest_desc: [
		"ATM 卡配合 ATM 机可异地存取，存钱罐则是家中的保险柜。"
		"上交 ATM 卡、便携 ATM 与存钱罐（不消耗）。"
	]
	quest.000000000000140D.title: "老虎机的诱惑"
	quest.000000000000140D.quest_desc: [
		"在老虎机上试试手气——硬币哗啦啦的声音就是酒馆的心跳。"
		"小赌怡情，大赌伤钱袋。"
		"上交老虎机（不消耗）。"
	]
	quest.000000000000140E.title: "票券经济"
	quest.000000000000140E.quest_desc: [
		"票券、售票亭与票务站构成完整的门票系统：活动入场、景点收费都靠它。"
		"上交票券与售票亭（不消耗）。"
	]
	quest.000000000000140F.title: "拍卖行"
	quest.000000000000140F.quest_desc: [
		"拍卖台支持玩家间公开竞价，是稀有酒品与藏品的最佳出场渠道。"
		"上交拍卖台（不消耗）。"
	]
	quest.0000000000001410.title: "付费闸门"
	quest.0000000000001410.quest_desc: [
		"付费闸门可对通行收费，配合票券系统实现景点门票经济。"
		"在自家酒馆门口装一个，过路费到手。"
		"上交付费闸门（不消耗）。"
	]
	quest.0000000000001616.title: "花与月之谷"
	quest.0000000000001616.quest_desc: [
		"Terralith 的樱花山谷与月光森林，是拍照打卡的绝佳背景。"
		"抵达两个群系即完成。"
	]
	quest.0000000000001617.title: "奇景打卡"
	quest.0000000000001617.quest_desc: [
		"翡翠尖峰高耸入云，白色悬崖一望无际——大地尽头的设计感。"
		"抵达两个群系即完成。"
	]
	quest.0000000000001618.title: "冰与幻影"
	quest.0000000000001618.quest_desc: [
		"冰川裂谷深处寒气逼人，幻影群岛漂浮云端。"
		"抵达两个群系即完成。"
	]
	quest.0000000000001619.title: "深境巡礼"
	quest.0000000000001619.quest_desc: [
		"末地四大遗迹：末地城堡、末地灯塔、末地沉船与三叉戟试炼碑。"
		"集齐四个结构打卡（DnT·nova_structures）。"
	]
	quest.0000000000001710.title: "东坡肉与驴肉火烧"
	quest.0000000000001710.quest_desc: [
		"森罗厨房硬菜二连：东坡肉肥而不腻，驴肉火烧外酥里嫩。"
		"上交两道菜（不消耗）。"
	]
	quest.0000000000001711.title: "四喜丸子与热干面"
	quest.0000000000001711.quest_desc: [
		"四喜丸子团团圆圆，热干面芝麻香浓。"
		"上交两道菜（不消耗）。"
	]
	quest.0000000000001712.title: "腊八粥与饺子"
	quest.0000000000001712.quest_desc: [
		"腊八粥暖心暖胃，饺子管饱管够。"
		"上交两道菜（不消耗）。"
	]
	quest.0000000000001713.title: "茶叶蛋"
	quest.0000000000001713.quest_desc: [
		"茶香入蛋，旅途最佳干粮。"
		"上交茶叶蛋（不消耗）。"
	]
	quest.0000000000001714.title: "全茶图鉴"
	quest.0000000000001714.quest_desc: [
		"碧螺春、乌龙、花茶、大麦茶——茶台上的四大常客。"
		"上交四种茶（不消耗）。"
	]
	quest.0000000000001715.title: "奶茶与谜之茶"
	quest.0000000000001715.quest_desc: [
		"酥油茶、瓦罐奶茶与谜之茶——最后一杯看运气。"
		"上交三种茶（不消耗）。"
	]
	quest.0000000000001716.title: "厨具大成"
	quest.0000000000001716.quest_desc: [
		"蒸笼、石磨与汤锅：中式厨房三大件。"
		"蒸笼出点心，石磨磨粉，汤锅煨汤。"
		"上交三件厨具（不消耗）。"
	]
	quest.0000000000001717.title: "黑暗料理界"
	quest.0000000000001717.quest_desc: [
		"谜之炒菜翻车现场——敢吃吗？"
		"上交黑暗料理与可疑炒菜（不消耗，放心不会真吃）。"
	]
	quest.000000000000180C.title: "世界名酒·六连"
	quest.000000000000180C.quest_desc: [
		"绝对伏特加、杰克丹尼、孟买蓝宝石、百加得、獺祭、竹叶青——世界名酒六大金刚入柜。"
		"上交六种名酒（不消耗）。"
	]
	quest.000000000000180D.title: "鸡尾酒·进阶五式"
	quest.000000000000180D.quest_desc: [
		"鲜虾鸡尾酒、椰林飘香、金汤力、环游世界与高球——调酒师的进阶功课。"
		"上交五种鸡尾酒（不消耗）。"
	]
	quest.000000000000180E.title: "酒吧特调"
	quest.000000000000180E.quest_desc: [
		"血腥玛丽、教父、翡翠与黄铜心脏——雪克杯的看家四式。"
		"上交四种特调（不消耗）。"
	]
	quest.000000000000180F.title: "极限特调"
	quest.000000000000180F.quest_desc: [
		"深水炸弹、下界特调、幽匿特调、绒球葱花园与本店招牌——敢全点一遍的是真酒客。"
		"上交五种特调（不消耗）。"
	]
	quest.0000000000001810.title: "图鉴大成 II"
	quest.0000000000001810.quest_desc: [
		"图鉴补全达成：你的酒柜已经可以开博物馆了。"
	]
	quest.000000000000190E.title: "女仆守护套装"
	quest.000000000000190E.quest_desc: [
		"溺水、坠落、魔法三重护符，再加替身地藏——女仆的保险柜。"
		"上交四件守护装备（不消耗）。"
	]
	quest.000000000000190F.title: "灵巧与磁力"
	quest.000000000000190F.quest_desc: [
		"闪避布提升闪避率，磁铁饰品自动拾取战利品。"
		"上交两件饰品（不消耗）。"
	]
	quest.0000000000001910.title: "禁言玉"
	quest.0000000000001910.quest_desc: [
		"世界太吵？禁言玉能让女仆安静下来。"
		"上交禁言玉（不消耗）。"
	]
	quest.0000000000001911.title: "压扁与求饶"
	quest.0000000000001911.quest_desc: [
		"哈气玩法的正确打开方式：把女仆压扁，听她求饶。"
		"护蛋糕模式下，她也会拼命守护蛋糕。"
		"都试过之后勾选完成。"
	]
	quest.0000000000001A0C.title: "弧光与喋血"
	quest.0000000000001A0C.quest_desc: [
		"弧光十字与喋血之心：攻守兼备的饰品双子。"
		"上交两件饰品（不消耗）。"
	]
	quest.0000000000001A0D.title: "狐叶一对"
	quest.0000000000001A0D.quest_desc: [
		"浮波狐叶善泳，熔岩狐叶耐火——狐之加护成对入手。"
		"上交两枚狐叶（不消耗）。"
	]
	quest.0000000000001A0E.title: "法术核心三件"
	quest.0000000000001A0E.quest_desc: [
		"法术强化核心、法术超限核心与法术射表：法术配置的三块拼图。"
		"上交三件核心（不消耗）。"
	]
	quest.0000000000001A10.title: "归隐之地巡礼"
	quest.0000000000001A10.quest_desc: [
		"透过梦云水晶进入归隐之地——万法皆通的隐藏维度。"
		"抵达该维度即完成。"
	]
	quest.0000000000001A11.title: "星辰遗迹"
	quest.0000000000001A11.quest_desc: [
		"星落之庭、观星塔与星途终岸——归隐之地的三大星辰遗迹。"
		"集齐三个结构打卡。"
	]
	quest.0000000000001A0F.title: "饰品大成"
	quest.0000000000001A0F.quest_desc: [
		"饰品收藏家认证：弧光、喋血与狐叶皆已入手。"
	]
	quest.0000000000001C0F.title: "陈酿大师"
	quest.0000000000001C0F.quest_desc: [
		"把酒瓶放入酒架或酒箱，时间会赋予它新的力量。"
		"地窖（无天光）陈酿速度 1.5 倍；每 6 酒年提升 1 级效果，最高 +5 级。"
		"陈出一瓶毕业级 buff 酒后勾选完成。"
	]
	quest.0000000000001C10.title: "果汁与汽水"
	quest.0000000000001C10.quest_desc: [
		"西瓜汁、可乐与酸梅汤——不喝酒的客人也有得选。"
		"上交三种饮料（不消耗）。"
	]

}
